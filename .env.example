FILMSPOTTING_LIBRARY_DIR=/ruta/a/tu/biblioteca
FILMSPOTTING_DATA_DIR=./data
# anthropic (Claude, de pago) | google (Gemini) | ollama (local y gratuito: `uv sync --extra ollama`)
FILMSPOTTING_PROVIDER=anthropic
FILMSPOTTING_MODEL=claude-opus-5-5
FILMSPOTTING_EFFORT=medium
ANTHROPIC_API_KEY=
# Gemini: API key de AI Studio, o Vertex AI (gcloud auth application-default login + proyecto)
FILMSPOTTING_GOOGLE_MODEL=gemini-3.5-flash
FILMSPOTTING_GOOGLE_FALLBACK_MODEL=
GOOGLE_API_KEY=
FILMSPOTTING_GOOGLE_VERTEXAI=false
FILMSPOTTING_GOOGLE_PROJECT=
FILMSPOTTING_GOOGLE_LOCATION=global
FILMSPOTTING_OLLAMA_MODEL=qwen2.5:7b
FILMSPOTTING_OLLAMA_BASE_URL=http://localhost:11434
# LangSmith (opcional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=filmspottingbot
